# --- SQL Server ATAK (read-only) ---
ATAK_SQL_SERVER=192.168.20.200
ATAK_SQL_PORT=8030
ATAK_SQL_DATABASE=SATKFRIOESTE
ATAK_SQL_USER=usuario_leitura
ATAK_SQL_PASSWORD=SenhaForte@123
ATAK_FILIAL=100

# Janela movel de reprocessamento (dias) — pega correcoes tardias
# (peso resfriado, aspersao preenchidos depois do abate)
ATAK_JANELA_DIAS=5

# --- Ingestao Supabase (push do abate + dominios) ---
INGEST_URL=https://horsymhsinqcimflrtjo.supabase.co/functions/v1/atak-ingest
INGEST_SECRET=COLE_AQUI_O_MESMO_SEGREDO_DO_EDGE
BATCH_SIZE=500

# --- Config-driven (leitura do mapa de dominios na nuvem PS) ---
# O coletor puxa os dominios ATIVOS do atak_fonte_mapa via fn_atak_mapa_coletor.
# A anon key e PUBLICA (nao e segredo). A senha do SQL Server continua so nas ATAK_SQL_* (Pilar 2).
SUPABASE_URL=https://horsymhsinqcimflrtjo.supabase.co
SUPABASE_ANON_KEY=COLE_AQUI_A_ANON_KEY_PUBLICA_DO_PROJETO
ATAK_COMPANY_ID=975365cc-9e5a-4251-9022-68c6bfde10d8
# Piso de data pra 1a carga (recorte, ex.: ultimos 12 meses). So no 1o ciclo de cada dominio
# COM watermark; da 2a em diante e incremental puro. Vazio = carga cheia. ASCII (YYYY-MM-DD).
ATAK_CARGA_DESDE=2025-08-04
